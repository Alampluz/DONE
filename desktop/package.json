{
  "name": "done-desktop",
  "productName": "DONE",
  "version": "1.0.0",
  "description": "DONE - CREA's ticket and task tracker for e-commerce, as a Windows desktop app",
  "author": "CREA Co., Ltd.",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "asia.crea.done",
    "productName": "DONE",
    "copyright": "CREA Co., Ltd.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DONE-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "DONE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Alampluz",
        "repo": "DONE",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "DONE",
        "schemes": [
          "done"
        ]
      }
    ]
  }
}
